{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/claude-notes-panel/schemas/board.schema.json",
  "title": "Claude Notes board spec",
  "description": "The document an agent writes to .claude/notes.json (scratch, overwritten per board) or that is archived to .claude/notes/<slug>.json. Additional properties are permitted everywhere on purpose: a newer skill must be able to talk to an older panel (FR-012).",
  "$comment": "TWO-TIER VALIDATION (FR-008 + FR-011). This file is the AUTHORING contract: editors should autocomplete from it and flag every violation. The RUNTIME validator must not treat every violation as fatal, or one typo'd `kind` would blank an entire board. Implementations compile TWO validators from this file: (1) FATAL - the document is an object, `title` is a non-empty string, `style` is a known value, and `style: mermaid` has `code`. A failure here posts `error` and nothing renders. (2) WARNING - everything else in this schema, including the `kind` and `shape` enums, plus the reference checks JSON Schema cannot express (an edge pointing at a missing id, an element in a missing frame). A failure here posts a normal `render` carrying `warnings`, so the valid part of the board still draws and the unknown value falls back (`kind` to `base`, `shape` to `rect`) with a reported warning rather than silently. See data-model.md V2, V3, V7.",
  "type": "object",
  "required": [
    "title"
  ],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "default": 1,
      "description": "Absent is treated as 1."
    },
    "style": {
      "enum": [
        "sketchy",
        "clean",
        "mermaid",
        "drawio"
      ],
      "default": "sketchy",
      "description": "'clean' renders the same layout with precise strokes. 'drawio' opens the board in an embedded draw.io editor \u2014 our layout decides where things start, draw.io owns editing. 'mermaid' renders the `code` field, or a flowchart derived from the board."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "BOARD IDENTITY. A changed title means 'this is a different board' and causes the outgoing board to be archived. Incremental rewrites of one board MUST reuse the title."
    },
    "layout": {
      "enum": [
        "columns",
        "rows"
      ],
      "default": "columns"
    },
    "maxWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 1500
    },
    "nodeWidth": {
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 270
    },
    "align": {
      "type": "string",
      "description": "Read by the renderer but undocumented in SKILL.md. Retained for compatibility; to be documented or removed."
    },
    "code": {
      "type": "string",
      "description": "Mermaid source. Required when style is 'mermaid', ignored otherwise."
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      },
      "deprecated": true,
      "description": "Undocumented alias for 'frames'. Accepted, not advertised."
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screen"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      },
      "deprecated": true,
      "description": "Undocumented alias for 'annotations'."
    },
    "legend": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/legendEntry"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "style": {
            "const": "mermaid"
          }
        },
        "required": [
          "style"
        ]
      },
      "then": {
        "required": [
          "code"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "enum": [
        "base",
        "problem",
        "fix",
        "data",
        "accent",
        "note",
        "muted"
      ],
      "default": "base",
      "description": "Semantic classification, not state. An unknown value falls back to 'base' and raises a warning rather than failing the board. These seven values are the rows of the 7x4 contrast matrix in SC-002."
    },
    "color": {
      "type": "string",
      "description": "A literal colour override. DISCOURAGED: it bypasses the theme binding and will not adapt to light or high-contrast themes (FR-021). Prefer 'kind'."
    },
    "frame": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Element ids in draw order. Wins over an element's own 'frame' field for ordering."
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "Alias for 'items'."
        },
        "flow": {
          "enum": [
            "col",
            "row"
          ],
          "default": "col"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "description": "MODE SWITCH: if ANY frame declares row or col, the whole board uses an explicit grid instead of flowing bands."
        },
        "col": {
          "type": "integer",
          "minimum": 0
        },
        "nodeWidth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "align": {
          "type": "string",
          "description": "Undocumented per-frame override."
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "titleColor": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "Also seeds the hand-drawn wobble, so it must be stable across incremental rewrites of the same board."
        },
        "label": {
          "type": "string",
          "description": "\\n honoured; wraps automatically."
        },
        "sub": {
          "type": "string",
          "description": "Dimmed second line. By convention the concrete evidence: a record id, a value."
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "shape": {
          "enum": [
            "rect",
            "round",
            "pill",
            "note",
            "ellipse",
            "diamond",
            "cyl"
          ],
          "default": "rect",
          "description": "An unknown value falls back to 'rect' with a warning."
        },
        "emphasis": {
          "type": "boolean",
          "description": "Thicker stroke and bold text. Convention: at most one per board."
        },
        "badge": {
          "type": "string",
          "maxLength": 32
        },
        "hatch": {
          "type": "boolean",
          "description": "Hand-shaded fill; conventionally 'not built yet'."
        },
        "frame": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "fill": {
          "$ref": "#/$defs/color"
        },
        "textColor": {
          "$ref": "#/$defs/color"
        },
        "x": {
          "type": "number",
          "deprecated": true
        },
        "y": {
          "type": "number",
          "deprecated": true
        },
        "w": {
          "type": "number",
          "deprecated": true,
          "description": "Legacy hand-placed width. AUTHORITATIVE when present."
        },
        "h": {
          "type": "number",
          "deprecated": true,
          "description": "Legacy hand-placed height. A MINIMUM only - asymmetric with 'w'."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "NEW and optional. Without it the wobble seed derives from from/to/label rather than array index, so inserting an edge no longer reshuffles every later edge."
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "source": {
          "$ref": "#/$defs/id",
          "deprecated": true,
          "description": "Undocumented alias for 'from'."
        },
        "target": {
          "$ref": "#/$defs/id",
          "deprecated": true,
          "description": "Undocumented alias for 'to'."
        },
        "label": {
          "type": "string"
        },
        "style": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ],
          "default": "solid"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "emphasis": {
          "type": "boolean"
        },
        "arrow": {
          "type": "boolean",
          "default": true,
          "description": "Only an actual false suppresses the head."
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      },
      "anyOf": [
        {
          "required": [
            "from",
            "to"
          ]
        },
        {
          "required": [
            "source",
            "target"
          ]
        }
      ]
    },
    "annotation": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": true,
      "properties": {
        "text": {
          "type": "string",
          "description": "\\n honoured. Also the wobble seed key."
        },
        "at": {
          "$ref": "#/$defs/id",
          "description": "Anchor element (node, table or screen)."
        },
        "atFrame": {
          "$ref": "#/$defs/id"
        },
        "place": {
          "enum": [
            "below",
            "above",
            "left",
            "right"
          ],
          "default": "right",
          "description": "THE MECHANISM. dx/dy are fine tuning on top of it, not a substitute."
        },
        "dx": {
          "type": "number"
        },
        "dy": {
          "type": "number"
        },
        "x": {
          "type": "number",
          "description": "Absolute fallback when there is no anchor."
        },
        "y": {
          "type": "number"
        },
        "anchor": {
          "enum": [
            "start",
            "middle",
            "end"
          ],
          "default": "start"
        },
        "size": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "default": 240
        },
        "rotate": {
          "type": "number"
        },
        "underline": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Undocumented in SKILL.md."
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "arrowTo": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "cell": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "text": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "kind": {
              "$ref": "#/$defs/kind"
            },
            "bold": {
              "type": "boolean"
            },
            "dim": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "row": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        },
        {
          "type": "object",
          "required": [
            "cells"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "$ref": "#/$defs/kind",
              "description": "Tints the whole record; a cell's own kind overrides it."
            },
            "cells": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/cell"
              }
            }
          }
        }
      ]
    },
    "table": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "frame": {
          "$ref": "#/$defs/id"
        },
        "columns": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "align": {
                    "enum": [
                      "left",
                      "right"
                    ],
                    "default": "left",
                    "description": "Convention: quantities are always 'right'."
                  },
                  "width": {
                    "type": "number",
                    "description": "Undocumented in SKILL.md."
                  }
                }
              }
            ]
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/row"
          }
        },
        "w": {
          "type": "number",
          "description": "Undocumented in SKILL.md."
        },
        "color": {
          "$ref": "#/$defs/color",
          "description": "Undocumented in SKILL.md."
        }
      }
    },
    "screen": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "frame": {
          "$ref": "#/$defs/id"
        },
        "color": {
          "$ref": "#/$defs/color"
        },
        "width": {
          "type": "number",
          "default": 660,
          "description": "A MINIMUM. Note: the current renderer grows it to fit an embedded table but NOT to fit wide field groups - a documented-but-approximate behaviour this feature reconciles."
        },
        "breadcrumb": {
          "type": "string"
        },
        "buttons": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "$ref": "#/$defs/kind"
                  },
                  "primary": {
                    "type": "boolean",
                    "description": "Fills the chip."
                  }
                }
              }
            ]
          }
        },
        "statusbar": {
          "type": "array",
          "description": "Right-aligned stage bar.",
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "kind": {
                    "$ref": "#/$defs/kind"
                  },
                  "active": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "title": {
                "type": "string"
              },
              "columns": {
                "type": "integer",
                "minimum": 1,
                "default": 2
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ]
                    },
                    "kind": {
                      "$ref": "#/$defs/kind"
                    },
                    "emphasis": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "table": {
          "$ref": "#/$defs/table",
          "description": "Embedded one2many list."
        },
        "footer": {
          "type": "string"
        }
      }
    },
    "legendEntry": {
      "type": "object",
      "required": [
        "label"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "$ref": "#/$defs/id",
          "description": "MUST be stable across rewrites of the same board. This is the only field in the schema with a cross-write stability requirement: it is what lets the panel tell 'already answered' from 'still pending', and what an Answer's questionId refers to."
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
