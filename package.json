{
  "name": "agent-board",
  "displayName": "Agent Board",
  "description": "Turns an AI coding agent's planning notes into a live, editable board \u2014 an embedded draw.io canvas, a hand-drawn whiteboard, or a mermaid diagram \u2014 with pen, sticky notes and inline answers that go back to the agent.",
  "version": "1.1.1",
  "license": "MIT",
  "publisher": "MostafaMahmoud",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Notebooks",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.agent/notes.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "agentBoard.open",
        "title": "Open Panel",
        "category": "Agent Board"
      },
      {
        "command": "agentBoard.clear",
        "title": "Clear Board",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.clearFeedback",
        "title": "Clear Marks (answers, pen, stickies)",
        "category": "Agent Board"
      },
      {
        "command": "agentBoard.saveBoard",
        "title": "Save Board to Library",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.openLibrary",
        "title": "Browse Board Library",
        "category": "Agent Board"
      },
      {
        "command": "agentBoard.setStyle",
        "title": "Change Render Style...",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.fit",
        "title": "Fit Board to Panel",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.resetZoom",
        "title": "Reset Zoom to 100%",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.copyDescription",
        "title": "Copy Board as Text",
        "category": "Agent Board",
        "enablement": "agentBoard.panelVisible"
      },
      {
        "command": "agentBoard.handOffFeedback",
        "title": "Copy Pending Replies for your agent",
        "category": "Agent Board"
      }
    ],
    "keybindings": [
      {
        "command": "agentBoard.open",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "agentBoard.clear",
          "when": "agentBoard.panelVisible"
        },
        {
          "command": "agentBoard.saveBoard",
          "when": "agentBoard.panelVisible"
        },
        {
          "command": "agentBoard.setStyle",
          "when": "agentBoard.panelVisible"
        },
        {
          "command": "agentBoard.fit",
          "when": "agentBoard.panelVisible"
        },
        {
          "command": "agentBoard.resetZoom",
          "when": "agentBoard.panelVisible"
        },
        {
          "command": "agentBoard.copyDescription",
          "when": "agentBoard.panelVisible"
        }
      ]
    },
    "configuration": {
      "title": "Agent Board",
      "properties": {
        "agentBoard.defaultStyle": {
          "type": "string",
          "enum": [
            "drawio",
            "sketchy",
            "clean",
            "mermaid"
          ],
          "default": "drawio",
          "enumDescriptions": [
            "draw.io \u2014 a full editing canvas (needs internet, or agentBoard.drawioUrl)",
            "Hand-drawn whiteboard, rendered in the panel",
            "Precise SVG, for sharing",
            "Formal graph types"
          ],
          "markdownDescription": "Render style used when a board does not declare one. `drawio` is the default: it is a real editing canvas, so a board can be reworked rather than only read. It loads from the internet unless `agentBoard.drawioUrl` points at a local copy \u2014 set this to `sketchy` to stay entirely offline."
        },
        "agentBoard.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the panel automatically when the workspace already has a board. A webview panel belongs to one window, so a second window shows nothing without this."
        },
        "agentBoard.notifyOnFeedback": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when an answer, note or drawing is captured, with a one-click handoff back to the agent."
        },
        "agentBoard.feedback.maxEntries": {
          "type": "number",
          "default": 500,
          "minimum": 10,
          "description": "Maximum entries kept in .agent/notes_feedback.json. Consumed entries are pruned first, oldest first; a pending answer is never dropped to make room."
        },
        "agentBoard.library.maxEntries": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "description": "Maximum boards kept in .agent/notes/."
        },
        "agentBoard.reducedMotion": {
          "type": "string",
          "enum": [
            "auto",
            "always"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Follow VS Code's workbench.reduceMotion setting",
            "Never animate in this panel"
          ],
          "description": "VS Code already owns this preference; 'always' forces motion off for this panel alone."
        },
        "agentBoard.drawioUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Where the draw.io editor is served from. Empty uses `https://embed.diagrams.net/`, which **requires internet**. For offline use, serve a copy of the draw.io web app and point this at it (for example `http://127.0.0.1:8080/`). The app is ~107 MB and is deliberately not bundled."
        },
        "agentBoard.drawioSketch": {
          "type": "boolean",
          "default": true,
          "description": "Use draw.io's hand-drawn rendering, so a board keeps the whiteboard look."
        }
      }
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/webview/tsconfig.json && tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/integration/tsconfig.json",
    "lint": "eslint src",
    "compile": "npm run check-types && npm run lint && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "npm run check-types && npm run lint && node esbuild.mjs --production",
    "pretest:unit": "node esbuild.mjs",
    "test:unit": "vitest run",
    "test": "vscode-test",
    "vscode:prepublish": "npm run package",
    "compile-tests": "tsc -p test/integration/tsconfig.json",
    "pretest": "npm run compile && npm run compile-tests",
    "render": "node tools/render-board.mjs",
    "probe": "node tools/browser/probe.mjs && node tools/browser/real-mouse.mjs",
    "verify": "./verify.sh"
  },
  "dependencies": {
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "@types/vscode-webview": "^1.57.5",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "jsdom": "^30.1.1",
    "ovsx": "^1.2.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a restricted workspace the panel renders boards read-only: it will not write to .agent/, save to the library, or render mermaid.",
      "restrictedConfigurations": [
        "agentBoard.openOnStartup"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a file-system watcher on a local workspace folder."
    }
  },
  "keywords": [
    "ai",
    "agent",
    "diagram",
    "whiteboard",
    "drawio",
    "mermaid",
    "sketch",
    "notes",
    "visualization"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mostafamahmoud-odoo/agent_board.git"
  },
  "bugs": {
    "url": "https://github.com/mostafamahmoud-odoo/agent_board/issues"
  },
  "homepage": "https://github.com/mostafamahmoud-odoo/agent_board#readme"
}
